{
    "configurations": [
        {
            "name": "Linux Kernel Module",
            "includePath": [
                "${workspaceFolder}/src",
                "/lib/modules/*/build/include",
                "/lib/modules/*/build/include/linux",
                "/lib/modules/*/build/include/uapi",
                "/lib/modules/*/build/include/generated",
                "/lib/modules/*/build/arch/x86/include",
                "/lib/modules/*/build/arch/x86/include/generated",
                "/lib/modules/*/build/arch/x86/include/uapi",
                "/lib/modules/*/build/arch/x86/include/generated/uapi",
                "/usr/src/linux-headers-*/include",
                "/usr/src/linux-headers-*/arch/x86/include"
            ],
            "defines": [
                "__KERNEL__",
                "MODULE",
                "LINUX",
                "__linux__",
                "__x86_64__",
                "CONFIG_X86_64",
                "KBUILD_MODNAME=\"${fileBasenameNoExtension}\"",
                "__GNUC__=9",
                "__GNUC_MINOR__=4"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu11",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerArgs": [
                "-nostdinc",
                "-isystem", "/usr/lib/gcc/x86_64-linux-gnu/9/include",
                "-include", "/lib/modules/*/build/include/linux/kconfig.h",
                "-include", "/lib/modules/*/build/include/linux/compiler_types.h",
                "-Wall",
                "-Wundef",
                "-Werror=strict-prototypes",
                "-Wno-trigraphs",
                "-fno-strict-aliasing",
                "-fno-common",
                "-fshort-wchar",
                "-fno-PIE",
                "-Werror=implicit-function-declaration",
                "-Werror=implicit-int",
                "-Wno-format-security",
                "-std=gnu11",
                "-mno-sse",
                "-mno-mmx",
                "-mno-sse2",
                "-mno-3dnow",
                "-mno-avx",
                "-m64",
                "-falign-jumps=1",
                "-falign-loops=1",
                "-mno-80387",
                "-mno-fp-ret-in-387",
                "-mpreferred-stack-boundary=3",
                "-mskip-rax-setup",
                "-mtune=generic",
                "-mno-red-zone",
                "-mcmodel=kernel",
                "-DCONFIG_X86_X32_ABI",
                "-DCONFIG_AS_CFI=1",
                "-DCONFIG_AS_CFI_SIGNAL_FRAME=1",
                "-DCONFIG_AS_CFI_SECTIONS=1",
                "-DCONFIG_AS_FXSAVEQ=1",
                "-DCONFIG_AS_SSSE3=1",
                "-DCONFIG_AS_AVX=1",
                "-DCONFIG_AS_AVX2=1",
                "-DCONFIG_AS_AVX512=1",
                "-DCONFIG_AS_SHA1_NI=1",
                "-DCONFIG_AS_SHA256_NI=1",
                "-pipe",
                "-Wno-sign-compare",
                "-fno-asynchronous-unwind-tables",
                "-mindirect-branch=thunk-extern",
                "-mindirect-branch-register",
                "-fno-jump-tables",
                "-fno-delete-null-pointer-checks",
                "-Wno-frame-address",
                "-Wno-format-truncation",
                "-Wno-format-overflow",
                "-Wno-address-of-packed-member",
                "-O2",
                "-fno-allow-store-data-races",
                "-Wframe-larger-than=2048",
                "-fstack-protector-strong",
                "-Wno-unused-but-set-variable",
                "-Wimplicit-fallthrough",
                "-Wno-unused-const-variable",
                "-fno-omit-frame-pointer",
                "-fno-optimize-sibling-calls",
                "-fno-var-tracking-assignments",
                "-pg",
                "-mrecord-mcount",
                "-mfentry",
                "-DCC_USING_FENTRY",
                "-Wdeclaration-after-statement",
                "-Wvla",
                "-Wno-pointer-sign",
                "-Wno-stringop-truncation",
                "-Wno-zero-length-bounds",
                "-Wno-array-bounds",
                "-Wno-stringop-overflow",
                "-Wno-restrict",
                "-Wno-maybe-uninitialized",
                "-fno-strict-overflow",
                "-fno-merge-all-constants",
                "-fmerge-constants",
                "-fno-stack-check",
                "-fconserve-stack"
            ]
        }
    ],
    "version": 4
}